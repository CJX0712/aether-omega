# 训练产物（可复现，无需入库）
# 例外：保留一个已训练好的 nano checkpoint（55MB），让第三方 clone 后无需训练
# 即可直接运行 scripts/infer.py 演示推理 / KV-cache 验证。其余权重仍忽略。
runs/
logs/
*.pt
!checkpoints/aether-nano-s1337.pt
*.pth
*.ckpt

# 数据集已随仓库发布（Tiny Shakespeare，公共领域文本，1.1MB）
# 目的：让第三方 clone 后无需联网即可完整复现。
# 如需重新拉取：python scripts/download_data.py --force
data/*.bin

# 证书报告产物
certificates/*.json
!certificates/.gitkeep

.DS_Store
Thumbs.db
*.swp
